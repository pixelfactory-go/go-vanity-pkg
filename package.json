{
  "name": "go-vanity-pkg",
  "type": "module",
  "scripts": {
    "css:build": "postcss src/styles/globals.css -o public/styles.css && cp public/styles.css styles.css",
    "css:watch": "postcss src/styles/globals.css -o public/styles.css --watch",
    "js:build": "bun scripts/build-theme-toggle.js",
    "prebuild": "bun run css:build && bun run js:build",
    "build": "echo 'Build complete'",
    "start": "bun run server.ts",
    "dev": "bun run css:build && bun run js:build && bun --watch server.ts",
    "dev:cf": "bun run css:build && bun run js:build && wrangler dev",
    "predeploy": "bun run css:build && bun run js:build",
    "deploy": "wrangler deploy --minify",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.11.5",
    "iconoir-react": "^7.11.0",
    "lucide-static": "^0.563.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.7",
    "@cloudflare/workers-types": "^4.20260206.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitest/coverage-istanbul": "^3.2.4",
    "autoprefixer": "^10.4.24",
    "happy-dom": "^20.5.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.18",
    "vitest": "^3.0.0",
    "wrangler": "^4.60.0"
  }
}